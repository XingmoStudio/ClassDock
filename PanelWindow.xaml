<Window
    x:Class="ClassDock.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fluent 2 浅色卡片：白底、8px 圆角、细分隔线；头部仅右上角设置按钮 -->
    <Grid x:Name="Root" Background="Transparent">
        <Border
            CornerRadius="8"
            Background="#FFFFFFFF"
            BorderBrush="#14000000"
            BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <Border
                    Grid.Row="0"
                    CornerRadius="8,8,0,0"
                    Background="#FFF9F9F9"
                    BorderBrush="#14000000"
                    BorderThickness="0,0,0,1"
                    Padding="8,6,8,6">
                    <Button
                        x:Name="SettingsButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        CornerRadius="4"
                        BorderThickness="0"
                        Background="Transparent"
                        Click="OnSettingsClick">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                            Glyph="&#xE713;"
                            FontSize="16" />
                    </Button>
                </Border>
                <Grid Grid.Row="1" Padding="10,8,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Margin="4,0,0,6"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#FF6B6B6B"
                        Text="工具" />
                    <!-- 屏幕批注入口 -->
                    <Button
                        x:Name="AnnotationButton"
                        Grid.Row="1"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="12,0"
                        Click="OnAnnotationClick">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PathIcon
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M4.09 6.41a3 3 0 0 0-1.35-.95L1.36 5a.54.54 0 0 1 0-1.03l1.38-.44A2.8 2.8 0 0 0 4.5 1.77l.01-.03.45-1.38a.54.54 0 0 1 1.03 0l.44 1.38a2.8 2.8 0 0 0 1.8 1.8l1.38.44.03.01a.54.54 0 0 1 0 1.03l-1.38.44a2.8 2.8 0 0 0-1.8 1.8l-.45 1.38A.6.6 0 0 1 5.5 9a.54.54 0 0 1-.51-.36l-.45-1.38q-.15-.46-.45-.85m7.7 3.8-.77-.25a1.6 1.6 0 0 1-1-1l-.25-.76a.3.3 0 0 0-.57 0l-.25.77a1.6 1.6 0 0 1-.98 1l-.77.24a.3.3 0 0 0 0 .57l.77.25a1.6 1.6 0 0 1 1 1l.24.77a.3.3 0 0 0 .58 0l.24-.77a1.6 1.6 0 0 1 1-1l.77-.24a.3.3 0 0 0 0-.57zm5.16-6.1L11.86 9.2l-.53-.2a1 1 0 0 1-.22-.13 1 1 0 0 1-.11-.22l-.18-.54 5.07-5.06a3.58 3.58 0 1 1 5.06 5.06l-.89.89a3.25 3.25 0 0 1 0 4.6l-1.79 1.77a.75.75 0 1 1-1.06-1.06L19 12.53c.69-.68.69-1.79.01-2.47l-10 10q-.62.62-1.48.82l-4.6 1.1a.75.75 0 0 1-.9-.9l1.1-4.6A3 3 0 0 1 3.94 15l3.14-3.14.54.17q.13.05.22.14a1 1 0 0 1 .14.23l.16.52L5 16.06a1.6 1.6 0 0 0-.42.76l-.82 3.42 3.42-.81q.44-.11.76-.43L19.9 7.05a2.08 2.08 0 0 0-2.94-2.94"
                                Foreground="#FF0078D4" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#FF1B1B1B"
                                Text="屏幕批注" />
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
