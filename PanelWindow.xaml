<Window
    x:Class="ClassDock.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fluent 2 浅色卡片：白底、8px 圆角、细分隔线；头部仅右上角设置按钮 -->
    <Grid x:Name="Root" Background="Transparent">
        <Border
            CornerRadius="8"
            Background="#FFFFFFFF"
            BorderBrush="#14000000"
            BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <Border
                    Grid.Row="0"
                    CornerRadius="8,8,0,0"
                    Background="#FFF9F9F9"
                    BorderBrush="#14000000"
                    BorderThickness="0,0,0,1"
                    Padding="8,6,8,6">
                    <Button
                        x:Name="SettingsButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        CornerRadius="4"
                        BorderThickness="0"
                        Background="Transparent"
                        Click="OnSettingsClick">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                            Glyph="&#xE713;"
                            FontSize="16" />
                    </Button>
                </Border>
                <!-- 工具列表：图标+文字横向排列，多个工具垂直向下堆叠，超出可滚动 -->
                <ScrollViewer
                    Grid.Row="1"
                    Padding="6,6,6,8"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">
                        <!-- 屏幕批注入口 -->
                        <Button
                            x:Name="AnnotationButton"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="12,0"
                            Click="OnAnnotationClick">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <PathIcon
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M12 2.5l2.35 7.15 7.15 2.35-7.15 2.35L12 21.5l-2.35-7.15L2.5 12l7.15-2.35Z"
                                    Foreground="#FF0078D4" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#FF1B1B1B"
                                    Text="屏幕批注" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
