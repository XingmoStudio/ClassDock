<Window
    x:Class="ClassDock.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fluent 2 浅色卡片：白底、8px 圆角、细分隔线；头部仅右上角设置按钮 -->
    <Grid x:Name="Root" Background="Transparent">
        <Border
            CornerRadius="8"
            Background="#FFFFFFFF"
            BorderBrush="#14000000"
            BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <Border
                    Grid.Row="0"
                    CornerRadius="8,8,0,0"
                    Background="#FFF9F9F9"
                    BorderBrush="#14000000"
                    BorderThickness="0,0,0,1"
                    Padding="8,6,8,6">
                    <Button
                        x:Name="SettingsButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        CornerRadius="4"
                        BorderThickness="0"
                        Background="Transparent"
                        Click="OnSettingsClick">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                            Glyph="&#xE713;"
                            FontSize="16" />
                    </Button>
                </Border>
                <!-- 工具列表：图标+文字横向排列，多个工具垂直向下堆叠，超出可滚动 -->
                <ScrollViewer
                    Grid.Row="1"
                    Padding="6,6,6,8"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">
                        <!-- 屏幕批注入口 -->
                        <Button
                            x:Name="AnnotationButton"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="12,0"
                            Click="OnAnnotationClick">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <PathIcon
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="m4.878.282l.348 1.071A2.2 2.2 0 0 0 6.624 2.75l1.072.348l.022.006a.423.423 0 0 1 0 .798l-1.072.348a2.2 2.2 0 0 0-1.399 1.397L4.9 6.717a.423.423 0 0 1-.798 0l-.348-1.07a2.2 2.2 0 0 0-1.399-1.403l-1.072-.348a.423.423 0 0 1 0-.798l1.072-.348a2.2 2.2 0 0 0 1.377-1.397L4.08.283a.423.423 0 0 1 .799 0m4.905 7.931l-.766-.248a1.58 1.58 0 0 1-.998-.999l-.25-.764a.302.302 0 0 0-.57 0l-.248.764a1.58 1.58 0 0 1-.984.999l-.765.248a.302.302 0 0 0 0 .57l.765.249a1.58 1.58 0 0 1 1 1.002l.248.764a.302.302 0 0 0 .57 0l.249-.764a1.58 1.58 0 0 1 .999-.999l.765-.248a.302.302 0 0 0 0-.57zm-3.768 2.134l.207.637l-1.97 1.97a1.44 1.44 0 0 0-.386.705l-.707 3.182l3.159-.702c.282-.063.54-.205.744-.409l9.358-9.358a1.975 1.975 0 0 0-2.793-2.792L9.965 7.242l-.637-.21a.7.7 0 0 1-.23-.14a.4.4 0 0 1-.088-.11l3.91-3.91a2.975 2.975 0 0 1 4.207 4.207l-.67.67l.336.337a2 2 0 0 1 0 2.828l-.94.94a.5.5 0 0 1-.707-.708l.94-.939a1 1 0 0 0 0-1.414l-.336-.336l-7.98 7.98a2.5 2.5 0 0 1-1.235.678l-3.926.873a.5.5 0 0 1-.597-.596l.878-3.95c.1-.453.328-.867.655-1.195l2.212-2.211a.6.6 0 0 1 .258.311"
                                    Foreground="#FF0078D4" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="#FF1B1B1B"
                                    Text="屏幕批注" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
