<Window
    x:Class="ClassDock.LogViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClassDock"
    Title="日志查看器">

    <Grid x:Name="Root" Background="{ThemeResource AppPageBackgroundBrush}" RowDefinitions="Auto,Auto,*">

        <Grid.Resources>
            <Style x:Key="LevelBadge" TargetType="Border">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <!-- 自绘标题栏拖拽区 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="16,0,0,0"
                FontSize="14"
                FontWeight="SemiBold"
                Text="日志查看器" />
            <TextBlock
                x:Name="CountText"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,156,0"
                FontSize="12"
                Foreground="{ThemeResource AppSecondaryTextBrush}" />
        </Grid>

        <!-- 工具栏：分类筛选 + 刷新 / 导出 / 清空 -->
        <Grid Grid.Row="1" Margin="16,4,16,10" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <Button x:Name="FilterAll" Click="OnFilterClick" Tag="All" Content="全部" />
                <Button x:Name="FilterInfo" Click="OnFilterClick" Tag="Info" Content="信息" />
                <Button x:Name="FilterWarn" Click="OnFilterClick" Tag="Warning" Content="警告" />
                <Button x:Name="FilterError" Click="OnFilterClick" Tag="Error" Content="错误" />
                <Button x:Name="FilterOther" Click="OnFilterClick" Tag="Other" Content="其他" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Click="OnRefreshClick" Content="刷新" />
                <Button Click="OnExportClick" Content="导出" />
                <Button Click="OnClearClick" Content="清空" />
            </StackPanel>
        </Grid>

        <!-- 日志列表 -->
        <ListView
            x:Name="LogList"
            Grid.Row="2"
            Margin="16,0,16,16"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="6,4" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:LogEntry">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <Border
                            Grid.Column="0"
                            Style="{StaticResource LevelBadge}"
                            Background="{x:Bind LevelBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            Width="72"
                            VerticalAlignment="Top"
                            FontSize="12"
                            Foreground="{ThemeResource AppSecondaryTextBrush}"
                            Text="{x:Bind Timestamp}" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            FontSize="13"
                            Foreground="{ThemeResource AppTextBrush}"
                            Text="{x:Bind Message}"
                            TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
