<Window
    x:Class="ClassDock.AnnotationToolbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 屏幕批注竖排工具栏（右侧居中），布局参考概念图 -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <!-- 状态画刷 -->
            <SolidColorBrush x:Key="ToolHoverBrush" Color="#0C000000" />
            <SolidColorBrush x:Key="ToolPressedBrush" Color="#16000000" />
            <SolidColorBrush x:Key="ToolCheckedBrush" Color="#160078D4" />
            <SolidColorBrush x:Key="ToolCheckedHoverBrush" Color="#240078D4" />
            <SolidColorBrush x:Key="ToolCheckedPressedBrush" Color="#320078D4" />

            <!-- ToggleButton / Button 各一份模板（XamlCompiler 不支持抽象 ButtonBase 作为 TargetType） -->
            <ControlTemplate x:Key="ToolToggleTemplate" TargetType="ToggleButton">
                <Grid
                    x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolHoverBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolPressedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Checked">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolCheckedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="CheckedPointerOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolCheckedHoverBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="CheckedPressed">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolCheckedPressedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Disabled" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="ToolButtonTemplate" TargetType="Button">
                <Grid
                    x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolHoverBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolPressedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
            </ControlTemplate>

            <Style x:Key="ToolToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FF2B2B2B" />
                <Setter Property="Template" Value="{StaticResource ToolToggleTemplate}" />
            </Style>

            <Style x:Key="ToolButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FF2B2B2B" />
                <Setter Property="Template" Value="{StaticResource ToolButtonTemplate}" />
            </Style>
        </Grid.Resources>

        <!-- 白色圆角竖条卡片 -->
        <Border
            x:Name="Card"
            Width="56"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#FFFFFFFF"
            BorderBrush="#14000000"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6">
            <StackPanel Spacing="2">
                <!-- 画笔 -->
                <ToggleButton
                    x:Name="PenButton"
                    Style="{StaticResource ToolToggleStyle}"
                    IsChecked="True"
                    ToolTipService.ToolTip="画笔"
                    Click="OnToolClick">
                    <PathIcon Width="20" Height="20" Data="{StaticResource IconInkingTool}" />
                </ToggleButton>
                <!-- 几何图形 -->
                <ToggleButton
                    x:Name="ShapesButton"
                    Style="{StaticResource ToolToggleStyle}"
                    ToolTipService.ToolTip="几何图形"
                    Click="OnToolClick">
                    <PathIcon Width="20" Height="20" Data="{StaticResource IconShapes}" />
                </ToggleButton>
                <!-- 橡皮 -->
                <ToggleButton
                    x:Name="EraserButton"
                    Style="{StaticResource ToolToggleStyle}"
                    ToolTipService.ToolTip="橡皮"
                    Click="OnToolClick">
                    <PathIcon Width="18" Height="18" Data="{StaticResource IconEraserSegment}" />
                </ToggleButton>
                <!-- 尺规与工具 -->
                <ToggleButton
                    x:Name="RulerButton"
                    Style="{StaticResource ToolToggleStyle}"
                    ToolTipService.ToolTip="尺规与工具"
                    Click="OnToolClick">
                    <PathIcon Width="18" Height="18" Data="{StaticResource IconRuler}" />
                </ToggleButton>
                <!-- 分隔 -->
                <Border
                    Height="1"
                    Margin="8,4"
                    Background="#14000000" />
                <!-- 返回主面板 -->
                <Button
                    x:Name="BackButton"
                    Style="{StaticResource ToolButtonStyle}"
                    ToolTipService.ToolTip="返回主面板"
                    Click="OnBackClick">
                    <PathIcon Width="20" Height="20" Data="{StaticResource IconArrowCircleLeft}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
