<Window
    x:Class="ClassDock.AnnotationCanvasWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      全屏批注层：底层是进入批注时抓取的屏幕快照，上层是透明画布，
      右侧竖排工具栏直接叠在同一窗口里（避免多窗口争夺置顶层级）。
      WinUI 3 没有 InkCanvas，用 Canvas + Pointer 事件自绘笔迹。
    -->
    <Grid
        x:Name="Root"
        Background="Black"
        PointerPressed="OnPointerPressed"
        PointerMoved="OnPointerMoved"
        PointerReleased="OnPointerReleased"
        PointerCaptureLost="OnPointerCaptureLost"
        PointerExited="OnPointerExited">
        <Grid.Resources>
            <!-- 状态画刷 -->
            <SolidColorBrush x:Key="ToolHoverBrush" Color="#0C000000" />
            <SolidColorBrush x:Key="ToolPressedBrush" Color="#16000000" />
            <SolidColorBrush x:Key="ToolCheckedBrush" Color="#160078D4" />
            <SolidColorBrush x:Key="ToolCheckedHoverBrush" Color="#240078D4" />
            <SolidColorBrush x:Key="ToolCheckedPressedBrush" Color="#320078D4" />

            <!-- ToggleButton / Button 各一份模板（XamlCompiler 不支持抽象 ButtonBase 作为 TargetType） -->
            <ControlTemplate x:Key="ToolToggleTemplate" TargetType="ToggleButton">
                <Grid
                    x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolHoverBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolPressedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Checked">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolCheckedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="CheckedPointerOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolCheckedHoverBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="CheckedPressed">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolCheckedPressedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Disabled" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="ToolButtonTemplate" TargetType="Button">
                <Grid
                    x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolHoverBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolPressedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
            </ControlTemplate>

            <Style x:Key="ToolToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FF2B2B2B" />
                <Setter Property="Template" Value="{StaticResource ToolToggleTemplate}" />
            </Style>

            <Style x:Key="ToolButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FF2B2B2B" />
                <Setter Property="Template" Value="{StaticResource ToolButtonTemplate}" />
            </Style>

            <!-- 笔类型选项（文字胶囊，宽度随内容） -->
            <Style x:Key="PenKindStyle" TargetType="ToggleButton">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FF2B2B2B" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Template" Value="{StaticResource ToolToggleTemplate}" />
            </Style>
        </Grid.Resources>

        <Image x:Name="Snapshot" Stretch="Fill" IsHitTestVisible="False" />
        <Canvas x:Name="InkLayer" />
        <!-- 尺规图层：刻度尺等工具浮在笔迹之上，但不参与保存合成；
             尺身会拦截指针事件（避免在尺子上画出笔迹），按钮因此可点击 -->
        <Canvas x:Name="RulerLayer" />

        <!-- 画笔设置面板（浅色）：上=笔迹粗细演示曲线（悬停变滑块），
             下=粗细档位与常用色块（最后一格彩虹圆点击展开调色盘），右侧=笔类型列表。
             画笔已选中时再点一次画笔按钮弹出/收起 -->
        <Border
            x:Name="PenPanel"
            Margin="0,0,80,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="#FFFFFFFF"
            BorderBrush="#1A000000"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            Visibility="Collapsed"
            PointerPressed="OnCardPressed">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="116" />
                </Grid.ColumnDefinitions>

                <!-- 左半：粗细演示 + 档位 + 色块 -->
                <StackPanel Spacing="12">
                    <!-- 笔迹粗细演示：悬停时曲线淡出、滑块浮现（Path 上不能写 x:Name） -->
                    <Grid
                        x:Name="ThicknessPreviewArea"
                        Height="96"
                        PointerEntered="OnPreviewAreaEntered"
                        PointerExited="OnPreviewAreaExited">
                        <Path
                            Width="300"
                            Height="96"
                            Data="M10,68 C40,20 100,14 150,46 C190,72 240,78 290,34"
                            Stroke="#FF3A3A3A"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeLineJoin="Round"
                            Stretch="None" />
                        <Slider
                            x:Name="ThicknessSlider"
                            Width="260"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Maximum="16"
                            Minimum="1"
                            Opacity="0"
                            StepFrequency="0.5"
                            Value="3"
                            ValueChanged="OnThicknessChanged" />
                    </Grid>

                    <!-- 粗细档位：默认几个档，点击即切换 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ThicknessLabel"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#FF3A3A3A"
                            Text="粗细 3" />
                        <StackPanel
                            Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="14">
                            <Border
                                Width="26" Height="26"
                                Background="Transparent"
                                PointerPressed="OnThicknessPresetPressed"
                                Tag="2">
                                <Ellipse Width="4" Height="4" Fill="#FF8A8A8A" />
                            </Border>
                            <Border
                                Width="26" Height="26"
                                Background="Transparent"
                                PointerPressed="OnThicknessPresetPressed"
                                Tag="5">
                                <Ellipse Width="7" Height="7" Fill="#FF8A8A8A" />
                            </Border>
                            <Border
                                Width="26" Height="26"
                                Background="Transparent"
                                PointerPressed="OnThicknessPresetPressed"
                                Tag="9">
                                <Ellipse Width="10" Height="10" Fill="#FF8A8A8A" />
                            </Border>
                            <Border
                                Width="26" Height="26"
                                Background="Transparent"
                                PointerPressed="OnThicknessPresetPressed"
                                Tag="14">
                                <Ellipse Width="13" Height="13" Fill="#FF8A8A8A" />
                            </Border>
                        </StackPanel>
                        <Button
                            x:Name="PinSliderButton"
                            Grid.Column="2"
                            Width="28"
                            Height="28"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnPinSliderClick"
                            ToolTipService.ToolTip="固定显示粗细滑块">
                            <Viewbox Width="12" Height="12">
                                <Path
                                    Width="24"
                                    Height="24"
                                    Data="M5 15l7-7 7 7"
                                    Fill="Transparent"
                                    Stroke="#FF8A8A8A"
                                    StrokeThickness="2"
                                    Stretch="None" />
                            </Viewbox>
                        </Button>
                    </Grid>

                    <!-- 常用色块：6×2，最后一格为调色盘入口（点击展开 ColorPicker） -->
                    <Grid x:Name="SwatchGrid" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Width="34" Height="34" Background="#FFFFFFFF" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="8" PointerPressed="OnSwatchPressed" Tag="#FFFFFFFF" />
                        <Border Grid.Row="0" Grid.Column="1" Width="34" Height="34" Background="#FFFF8C00" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="8" PointerPressed="OnSwatchPressed" Tag="#FFFF8C00" />
                        <Border Grid.Row="0" Grid.Column="2" Width="34" Height="34" Background="#FFFFC300" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="8" PointerPressed="OnSwatchPressed" Tag="#FFFFC300" />
                        <Border Grid.Row="0" Grid.Column="3" Width="34" Height="34" Background="#FF6BB5D8" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="8" PointerPressed="OnSwatchPressed" Tag="#FF6BB5D8" />
                        <Border Grid.Row="0" Grid.Column="4" Width="34" Height="34" Background="#FF5FD35F" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="8" PointerPressed="OnSwatchPressed" Tag="#FF5FD35F" />
                        <Border Grid.Row="0" Grid.Column="5" Width="34" Height="34" Background="#FFFF4FA3" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="8" PointerPressed="OnSwatchPressed" Tag="#FFFF4FA3" />

                        <Border Grid.Row="1" Grid.Column="0" Width="34" Height="34" Background="#FF1A1A1A" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="8" PointerPressed="OnSwatchPressed" Tag="#FF1A1A1A" />
                        <Border Grid.Row="1" Grid.Column="1" Width="34" Height="34" Background="#FF4B3FD9" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="8" PointerPressed="OnSwatchPressed" Tag="#FF4B3FD9" />
                        <Border Grid.Row="1" Grid.Column="2" Width="34" Height="34" Background="#FFE81123" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="8" PointerPressed="OnSwatchPressed" Tag="#FFE81123" />
                        <Border Grid.Row="1" Grid.Column="3" Width="34" Height="34" Background="#FF2F7DD1" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="8" PointerPressed="OnSwatchPressed" Tag="#FF2F7DD1" />
                        <Border Grid.Row="1" Grid.Column="4" Width="34" Height="34" Background="#FF1F6B33" BorderBrush="#1F000000" BorderThickness="1" CornerRadius="8" PointerPressed="OnSwatchPressed" Tag="#FF1F6B33" />

                        <!-- 调色盘入口 -->
                        <Border
                            x:Name="ColorWheelSwatch"
                            Grid.Row="1"
                            Grid.Column="5"
                            Width="34"
                            Height="34"
                            Background="#FFFFFFFF"
                            BorderBrush="#1F000000"
                            BorderThickness="1"
                            CornerRadius="17"
                            PointerPressed="OnColorWheelPressed"
                            ToolTipService.ToolTip="更多颜色">
                            <Grid>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Offset="0" Color="#FFFF2D2D" />
                                            <GradientStop Offset="0.17" Color="#FFFFCC00" />
                                            <GradientStop Offset="0.34" Color="#FF5FD35F" />
                                            <GradientStop Offset="0.5" Color="#FF2FD9C5" />
                                            <GradientStop Offset="0.67" Color="#FF3D7DFF" />
                                            <GradientStop Offset="0.84" Color="#FFA24DFF" />
                                            <GradientStop Offset="1" Color="#FFFF2D8F" />
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="12" Height="12" Fill="#FFFFFFFF" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- 右半：笔类型列表（图标 + 文字；激光笔暂未开放） -->
                <Border
                    Grid.Column="1"
                    Padding="6"
                    BorderBrush="#1F000000"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="4">
                        <ToggleButton
                            x:Name="LaserButton"
                            Foreground="#FFB3B3B3"
                            IsEnabled="False"
                            Style="{StaticResource PenKindStyle}"
                            ToolTipService.ToolTip="暂未开放">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="17" Height="17">
                                    <Path
                                        Width="20" Height="20"
                                        Data="M14.458 1.666a.5.5 0 1 0-1 0v.833a.5.5 0 0 0 1 0zM17.853 2.853a.5.5 0 0 0-.707-.707l-1.5 1.5a.5.5 0 0 0 .707.707zM7.853 12.853a.5.5 0 1 0-.707-.707l-1 1a.5.5 0 1 0 .707.707zM7 4.999v3.793l-4.292 4.293a2 2 0 0 0 0 2.829l1.379 1.378a2 2 0 0 0 2.828 0L11.207 13h3.792a.5.5 0 0 0 .354-.146l1.44-1.44a2 2 0 0 0 0-2.828l-5.38-5.379a2 2 0 0 0-2.828 0l-1.44 1.44A.5.5 0 0 0 7 4.999M9.293 3.914a1 1 0 0 1 1.415 0l5.378 5.378a1 1 0 0 1 0 1.415L15 11.792L8.208 5zM8 6.206L13.792 12h-2.585L7.999 8.792zM7.5 9.706l2.794 2.793l-4.086 4.086a1 1 0 0 1-1.414 0l-1.379-1.378a1 1 0 0 1 0-1.415zM17.5 5.541a.5.5 0 1 0 0 1h.834a.5.5 0 1 0 0-1z"
                                        Fill="#FFB3B3B3"
                                        Stretch="None" />
                                </Viewbox>
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="激光笔" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="HighlighterButton"
                            Style="{StaticResource PenKindStyle}"
                            ToolTipService.ToolTip="半透明宽笔触"
                            Click="OnPenKindClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="17" Height="17">
                                    <Path
                                        Width="20" Height="20"
                                        Data="M3.5 2a.5.5 0 0 1 .5.5v4a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5v-4a.5.5 0 0 1 1 0v4a1.5 1.5 0 0 1-1 1.415V9a2 2 0 0 1-2 2v2.073a2 2 0 0 1-1.106 1.789l-6.17 3.085A.5.5 0 0 1 6 17.5V11a2 2 0 0 1-2-2V7.915A1.5 1.5 0 0 1 3 6.5v-4a.5.5 0 0 1 .5-.5M5 8v1a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V8zM7 11v5.691l5.447-2.724a1 1 0 0 0 .553-.894V11z"
                                        Fill="#FF2B2B2B"
                                        Stretch="None" />
                                </Viewbox>
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="荧光笔" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="HardPenButton"
                            IsChecked="True"
                            Style="{StaticResource PenKindStyle}"
                            ToolTipService.ToolTip="粗细均匀、无笔锋"
                            Click="OnPenKindClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="17" Height="17">
                                    <Path
                                        Width="20" Height="20"
                                        Data="M17.18 2.926a2.975 2.975 0 0 0-4.26-.054l-9.375 9.375a2.44 2.44 0 0 0-.655 1.194l-.878 3.95a.5.5 0 0 0 .597.597l3.926-.873a2.5 2.5 0 0 0 1.234-.678l7.98-7.98l.337.336a1 1 0 0 1 0 1.414l-.94.94a.5.5 0 0 0 .708.706l.939-.94a2 2 0 0 0 0-2.828l-.336-.336l.67-.67a2.975 2.975 0 0 0 .052-4.153m-3.553.653a1.975 1.975 0 0 1 2.793 2.793L7.062 15.73a1.5 1.5 0 0 1-.744.409l-3.16.702l.708-3.183a1.43 1.43 0 0 1 .387-.704z"
                                        Fill="#FF2B2B2B"
                                        Stretch="None" />
                                </Viewbox>
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="硬笔" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            x:Name="SoftPenButton"
                            Style="{StaticResource PenKindStyle}"
                            ToolTipService.ToolTip="带笔锋，快速提笔出尖"
                            Click="OnPenKindClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="17" Height="17">
                                    <Path
                                        Width="20" Height="20"
                                        Data="M17.18 2.926a2.975 2.975 0 0 0-4.26-.054l-9.375 9.375a2.44 2.44 0 0 0-.655 1.194l-.878 3.95a.5.5 0 0 0 .597.597l3.926-.873a2.5 2.5 0 0 0 1.234-.678l7.98-7.98l.337.336a1 1 0 0 1 0 1.414l-.94.94a.5.5 0 0 0 .708.706l.939-.94a2 2 0 0 0 0-2.828l-.336-.336l.67-.67a2.975 2.975 0 0 0 .052-4.153m-3.553.653a1.975 1.975 0 0 1 2.793 2.793L7.062 15.73a1.5 1.5 0 0 1-.744.409l-3.16.702l.708-3.183a1.43 1.43 0 0 1 .387-.704z"
                                        Fill="#FF2B2B2B"
                                        Stretch="None" />
                                </Viewbox>
                                <TextBlock VerticalAlignment="Center" FontSize="13" Text="软笔" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 橡皮设置面板（浅色）：清空 + 竖向分隔线 + 三档大小。
             橡皮已选中时再点一次橡皮按钮弹出/收起 -->
        <Border
            x:Name="EraserPanel"
            Margin="0,0,80,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="#FFFFFFFF"
            BorderBrush="#1A000000"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            Visibility="Collapsed"
            PointerPressed="OnCardPressed">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <!-- 清空 -->
                <Button
                    x:Name="ClearButton"
                    Style="{StaticResource ToolButtonStyle}"
                    Width="56"
                    Height="72"
                    ToolTipService.ToolTip="清空所有笔迹"
                    Click="OnEraserClearClick">
                    <StackPanel Spacing="6">
                        <Viewbox Width="20" Height="20">
                            <Path
                                Width="20"
                                Height="20"
                                Data="M8.5 4h3a1.5 1.5 0 0 0-3 0m-1 0a2.5 2.5 0 0 1 5 0h5a.5.5 0 0 1 0 1h-1.054l-1.194 10.344A3 3 0 0 1 12.272 18H7.728a3 3 0 0 1-2.98-2.656L3.554 5H2.5a.5.5 0 0 1 0-1zM5.741 15.23A2 2 0 0 0 7.728 17h4.544a2 2 0 0 0 1.987-1.77L15.439 5H4.561zM8.5 7.5A.5.5 0 0 1 9 8v6a.5.5 0 0 1-1 0V8a.5.5 0 0 1 .5-.5M12 8a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"
                                Fill="#FF2B2B2B"
                                Stretch="None" />
                        </Viewbox>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="#FF2B2B2B"
                            Text="清空" />
                    </StackPanel>
                </Button>

                <!-- 竖向分隔线 -->
                <Border
                    Width="1"
                    Margin="0,4"
                    Background="#14000000" />

                <!-- 三档大小 -->
                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <TextBlock
                        x:Name="EraserSizeLabel"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#FF2B2B2B"
                        Text="大小 中" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border
                            Width="28" Height="28"
                            Background="Transparent"
                            PointerPressed="OnEraserSizePresetPressed"
                            Tag="6">
                            <Ellipse Width="8" Height="8" Fill="#FF8A8A8A" />
                        </Border>
                        <Border
                            Width="28" Height="28"
                            Background="Transparent"
                            PointerPressed="OnEraserSizePresetPressed"
                            Tag="12">
                            <Ellipse Width="14" Height="14" Fill="#FF8A8A8A" />
                        </Border>
                        <Border
                            Width="28" Height="28"
                            Background="Transparent"
                            PointerPressed="OnEraserSizePresetPressed"
                            Tag="20">
                            <Ellipse Width="20" Height="20" Fill="#FF8A8A8A" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 几何图形设置面板（浅色）：两行图形选择 + 三档粗细。
             几何图形已选中时再点一次按钮弹出/收起 -->
        <Border
            x:Name="ShapesPanel"
            Margin="0,0,80,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="#FFFFFFFF"
            BorderBrush="#1A000000"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14"
            Visibility="Collapsed"
            PointerPressed="OnCardPressed">
            <StackPanel Spacing="8">
                <!-- 第一行：矩形 / 三角形 / 直线 / 箭头 / 圆形 -->
                <StackPanel x:Name="ShapeRow1" Orientation="Horizontal" Spacing="4">
                    <Border Width="32" Height="32" Background="Transparent" CornerRadius="8" PointerPressed="OnShapeOptionPressed" Tag="Rectangle" ToolTipService.ToolTip="矩形">
                        <Path Width="20" Height="20" Data="M4.5 5.5h11v9h-11z" Fill="Transparent" Stroke="#FF2B2B2B" StrokeThickness="1.5" Stretch="None" />
                    </Border>
                    <Border Width="32" Height="32" Background="Transparent" CornerRadius="8" PointerPressed="OnShapeOptionPressed" Tag="Triangle" ToolTipService.ToolTip="三角形">
                        <Path Width="20" Height="20" Data="M10 4.5 L16 15.5 H4 Z" Fill="Transparent" Stroke="#FF2B2B2B" StrokeThickness="1.5" Stretch="None" />
                    </Border>
                    <Border Width="32" Height="32" Background="Transparent" CornerRadius="8" PointerPressed="OnShapeOptionPressed" Tag="Line" ToolTipService.ToolTip="直线">
                        <Path Width="20" Height="20" Data="M3.5 10 H16.5" Fill="Transparent" Stroke="#FF2B2B2B" StrokeThickness="1.5" Stretch="None" />
                    </Border>
                    <Border Width="32" Height="32" Background="Transparent" CornerRadius="8" PointerPressed="OnShapeOptionPressed" Tag="Arrow" ToolTipService.ToolTip="箭头">
                        <Path Width="20" Height="20" Data="M3.5 10 H15 M10.5 5.5 L15.5 10 L10.5 14.5" Fill="Transparent" Stroke="#FF2B2B2B" StrokeThickness="1.5" Stretch="None" />
                    </Border>
                    <Border Width="32" Height="32" Background="Transparent" CornerRadius="8" PointerPressed="OnShapeOptionPressed" Tag="Circle" ToolTipService.ToolTip="圆形">
                        <Path Width="20" Height="20" Data="M4.5 10 a5.5 5.5 0 1 0 11 0 a5.5 5.5 0 1 0 -11 0 z" Fill="Transparent" Stroke="#FF2B2B2B" StrokeThickness="1.5" Stretch="None" />
                    </Border>
                </StackPanel>
                <!-- 第二行：圆角矩形 / 直角三角形 / 虚线箭头 / 椭圆 / 虚线 -->
                <StackPanel x:Name="ShapeRow2" Orientation="Horizontal" Spacing="4">
                    <Border Width="32" Height="32" Background="Transparent" CornerRadius="8" PointerPressed="OnShapeOptionPressed" Tag="RoundedRectangle" ToolTipService.ToolTip="圆角矩形">
                        <Path Width="20" Height="20" Data="M6.5 4.5h7a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z" Fill="Transparent" Stroke="#FF2B2B2B" StrokeThickness="1.5" Stretch="None" />
                    </Border>
                    <Border Width="32" Height="32" Background="Transparent" CornerRadius="8" PointerPressed="OnShapeOptionPressed" Tag="RightTriangle" ToolTipService.ToolTip="直角三角形">
                        <Path Width="20" Height="20" Data="M5 4.5 V15.5 H16 Z" Fill="Transparent" Stroke="#FF2B2B2B" StrokeThickness="1.5" Stretch="None" />
                    </Border>
                    <Border Width="32" Height="32" Background="Transparent" CornerRadius="8" PointerPressed="OnShapeOptionPressed" Tag="DashedArrow" ToolTipService.ToolTip="虚线箭头">
                        <Path Width="20" Height="20" Data="M3.5 10 H15 M10.5 5.5 L15.5 10 L10.5 14.5" Fill="Transparent" Stroke="#FF2B2B2B" StrokeDashArray="2,2" StrokeThickness="1.5" Stretch="None" />
                    </Border>
                    <Border Width="32" Height="32" Background="Transparent" CornerRadius="8" PointerPressed="OnShapeOptionPressed" Tag="Ellipse" ToolTipService.ToolTip="椭圆">
                        <Path Width="20" Height="20" Data="M3 10 a7 4.5 0 1 0 14 0 a7 4.5 0 1 0 -14 0 z" Fill="Transparent" Stroke="#FF2B2B2B" StrokeThickness="1.5" Stretch="None" />
                    </Border>
                    <Border Width="32" Height="32" Background="Transparent" CornerRadius="8" PointerPressed="OnShapeOptionPressed" Tag="DashedLine" ToolTipService.ToolTip="虚线">
                        <Path Width="20" Height="20" Data="M3.5 10 H16.5" Fill="Transparent" Stroke="#FF2B2B2B" StrokeDashArray="2,2" StrokeThickness="1.5" Stretch="None" />
                    </Border>
                </StackPanel>
                <!-- 分隔线 + 三档粗细（右对齐斜杠，越粗越高） -->
                <Border Height="1" Margin="0,2" Background="#14000000" />
                <StackPanel x:Name="ShapeThicknessRow" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Border Width="30" Height="30" Background="Transparent" CornerRadius="8" PointerPressed="OnShapeThicknessPressed" Tag="2" ToolTipService.ToolTip="细">
                        <Border Width="16" Height="2.5" Background="#FF8A8A8A" CornerRadius="1.25" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-45" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <Border Width="30" Height="30" Background="Transparent" CornerRadius="8" PointerPressed="OnShapeThicknessPressed" Tag="3.5" ToolTipService.ToolTip="中">
                        <Border Width="16" Height="4" Background="#FF8A8A8A" CornerRadius="2" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-45" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <Border Width="30" Height="30" Background="Transparent" CornerRadius="8" PointerPressed="OnShapeThicknessPressed" Tag="5" ToolTipService.ToolTip="粗">
                        <Border Width="16" Height="5.5" Background="#FF8A8A8A" CornerRadius="2.75" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-45" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 工具面板（浅色）：列表排布的工具选项。选中尺规工具即弹出，再点一次收起 -->
        <Border
            x:Name="ToolPanel"
            Margin="0,0,80,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="#FFFFFFFF"
            BorderBrush="#1A000000"
            BorderThickness="1"
            CornerRadius="12"
            Padding="8"
            Visibility="Collapsed"
            PointerPressed="OnCardPressed">
            <StackPanel Spacing="2">
                <!-- 保存至本地：画布内容连带底图导出为图片 -->
                <Border
                    Background="Transparent"
                    CornerRadius="8"
                    Padding="10,8"
                    PointerPressed="OnSaveToLocalPressed"
                    ToolTipService.ToolTip="将画布内容与底图保存为图片">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Viewbox Width="20" Height="20">
                            <Path
                                Width="24"
                                Height="24"
                                Data="M13.821 6.5h5.929A2.25 2.25 0 0 1 22 8.75v9.5A2.75 2.75 0 0 1 19.25 21H4.75A2.75 2.75 0 0 1 2 18.25V4.75A2.75 2.75 0 0 1 4.75 2h3.733c1.562 0 2.098.52 2.64 1.206l1.4 1.794a.75.75 0 0 0 .548.5h5.679zM3.5 4.75v4.75h17V8.75a.75.75 0 0 0-.75-.75h-5.629a2.25 2.25 0 0 1-1.458-.5l-.25-.206l-1.4-1.793c-.293-.376-.549-.62-1.016-.686L4.75 3.5a1.25 1.25 0 0 0-1.25 1.25zM3.5 11v7.25c0 .69.56 1.25 1.25 1.25h14.5c.69 0 1.25-.56 1.25-1.25V11H3.5z"
                                Fill="#FF2B2B2B"
                                Stretch="None" />
                        </Viewbox>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#FF2B2B2B"
                            Text="保存至本地" />
                    </StackPanel>
                </Border>
                <!-- 屏幕刻度尺：召唤/收回一把直尺 -->
                <Border
                    x:Name="ScreenRulerOption"
                    Background="Transparent"
                    CornerRadius="8"
                    Padding="10,8"
                    PointerPressed="OnScreenRulerPressed"
                    ToolTipService.ToolTip="在屏幕上召唤一把直尺">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Viewbox Width="20" Height="20">
                            <Path
                                Width="24"
                                Height="24"
                                Data="M17.25 3A2.75 2.75 0 0 1 20 5.75v12.5A2.75 2.75 0 0 1 17.25 21H6.75A2.75 2.75 0 0 1 4 18.25V5.75A2.75 2.75 0 0 1 6.75 3h10.5zm0 1.5H6.75c-.69 0-1.25.56-1.25 1.25v2h3.75a.75.75 0 0 1 0 1.5H5.5v2h2.75a.75.75 0 0 1 0 1.5H5.5v2h3.75a.75.75 0 0 1 0 1.5H5.5v3.75c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25V5.75c0-.69-.56-1.25-1.25-1.25z"
                                Fill="#FF2B2B2B"
                                Stretch="None" />
                        </Viewbox>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#FF2B2B2B"
                            Text="屏幕刻度尺" />
                    </StackPanel>
                </Border>
                <!-- 圆规：召唤/收回一只圆规 -->
                <Border
                    x:Name="CompassOption"
                    Background="Transparent"
                    CornerRadius="8"
                    Padding="10,8"
                    PointerPressed="OnCompassOptionPressed"
                    ToolTipService.ToolTip="在屏幕上召唤一只圆规">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Viewbox Width="20" Height="20">
                            <Canvas
                                Width="24"
                                Height="24">
                                <Ellipse
                                    Canvas.Left="10.3"
                                    Canvas.Top="2.2"
                                    Width="3.4"
                                    Height="3.4"
                                    Fill="#FF2B2B2B" />
                                <Path
                                    Data="M12 5.6 L7.2 19 M12 5.6 L16.8 19 M8.6 14 L15.4 14 M7.2 19 Q12 22.2 16.8 19"
                                    Stroke="#FF2B2B2B"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.5" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#FF2B2B2B"
                            Text="圆规" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 白色圆角竖条卡片：靠右侧垂直居中 -->
        <Border
            x:Name="Card"
            Width="56"
            Margin="0,0,12,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="#FFFFFFFF"
            BorderBrush="#14000000"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6"
            PointerPressed="OnCardPressed">
            <StackPanel Spacing="2">
                <!-- 画笔 -->
                <ToggleButton
                    x:Name="PenButton"
                    Style="{StaticResource ToolToggleStyle}"
                    IsChecked="True"
                    ToolTipService.ToolTip="画笔"
                    Click="OnToolClick">
                    <Viewbox Width="20" Height="20">
                        <Path
                            Width="24"
                            Height="24"
                            Data="M4.5 2.75a.75.75 0 0 0-1.5 0v3.5C3 7.216 3.784 8 4.75 8h.265l4.036 8.968a1.75 1.75 0 0 0 1.044.943A6 6 0 0 0 10 19c0 .671.09 1.366.363 1.921c.292.595.83 1.079 1.637 1.079s1.345-.484 1.637-1.079c.272-.555.363-1.25.363-1.921c0-.367-.027-.738-.095-1.09a1.75 1.75 0 0 0 1.044-.942L18.985 8h.265A1.75 1.75 0 0 0 21 6.25v-3.5a.75.75 0 0 0-1.5 0v3.5a.25.25 0 0 1-.25.25H4.75a.25.25 0 0 1-.25-.25zM6.66 8h10.68l-3.759 8.353a.25.25 0 0 1-.228.147h-2.706a.25.25 0 0 1-.228-.147zM11.613 18h.774c.071.256.113.594.113 1c0 .572-.083 1.002-.21 1.26c-.108.22-.195.24-.29.24s-.182-.02-.29-.24c-.127-.258-.21-.689-.21-1.26c0-.406.042-.744.113-1"
                            Fill="#FF2B2B2B"
                            Stretch="None" />
                    </Viewbox>
                </ToggleButton>
                <!-- 几何图形 -->
                <ToggleButton
                    x:Name="ShapesButton"
                    Style="{StaticResource ToolToggleStyle}"
                    ToolTipService.ToolTip="几何图形"
                    Click="OnToolClick">
                    <Viewbox Width="20" Height="20">
                        <Path
                            Width="24"
                            Height="24"
                            Data="M8.75 3.5A5.25 5.25 0 0 0 8 13.947v1.512A6.751 6.751 0 1 1 15.459 8h-1.512A5.25 5.25 0 0 0 8.75 3.5M12.25 9A3.25 3.25 0 0 0 9 12.25v6.5A3.25 3.25 0 0 0 12.25 22h6.5A3.25 3.25 0 0 0 22 18.75v-6.5A3.25 3.25 0 0 0 18.75 9ZM10.5 12.25c0-.966.784-1.75 1.75-1.75h6.5c.966 0 1.75.784 1.75 1.75v6.5a1.75 1.75 0 0 1-1.75 1.75h-6.5a1.75 1.75 0 0 1-1.75-1.75z"
                            Fill="#FF2B2B2B"
                            Stretch="None" />
                    </Viewbox>
                </ToggleButton>
                <!-- 擦除 -->
                <ToggleButton
                    x:Name="EraserButton"
                    Style="{StaticResource ToolToggleStyle}"
                    ToolTipService.ToolTip="擦除"
                    Click="OnToolClick">
                    <Viewbox Width="20" Height="20">
                        <Path
                            Width="24"
                            Height="24"
                            Data="M15.841 2.661a2.25 2.25 0 0 0-3.19-.023l-9.598 9.508a2.25 2.25 0 0 0 .007 3.204l5.099 5.008a2.24 2.24 0 0 0 1.69.642h6.265a2.501 2.501 0 1 0 0-1.5h-3.953l8.583-8.673a2.25 2.25 0 0 0 .007-3.158zM9.75 19.5v.002a.75.75 0 0 1-.54-.214l-5.1-5.008a.75.75 0 0 1-.002-1.068l1.53-1.514l6.098 6.099l-1.468 1.483a.75.75 0 0 1-.468.22zM13.707 3.704a.75.75 0 0 1 1.063.007l4.91 5.009a.75.75 0 0 1-.002 1.052L12.79 16.73l-6.088-6.088z"
                            Fill="#FF2B2B2B"
                            Stretch="None" />
                    </Viewbox>
                </ToggleButton>
                <!-- 工具 -->
                <ToggleButton
                    x:Name="RulerButton"
                    Style="{StaticResource ToolToggleStyle}"
                    ToolTipService.ToolTip="工具"
                    Click="OnToolClick">
                    <Viewbox Width="20" Height="20">
                        <Path
                            Width="24"
                            Height="24"
                            Data="M9.25 2A2.25 2.25 0 0 0 7 4.25v15.5A2.25 2.25 0 0 0 9.25 22h5.5A2.25 2.25 0 0 0 17 19.75V4.25A2.25 2.25 0 0 0 14.75 2zM8.5 19h1.75a.75.75 0 0 0 0-1.5H8.5V16h3.75a.75.75 0 0 0 0-1.5H8.5v-1.75h1.75a.75.75 0 0 0 0-1.5H8.5V9.5h3.75a.75.75 0 0 0 0-1.5H8.5V6.5h1.75a.75.75 0 0 0 0-1.5H8.5v-.75a.75.75 0 0 1 .75-.75h5.5a.75.75 0 0 1 .75.75v15.5a.75.75 0 0 1-.75.75h-5.5a.75.75 0 0 1-.75-.75z"
                            Fill="#FF2B2B2B"
                            Stretch="None" />
                    </Viewbox>
                </ToggleButton>
                <!-- 分隔 -->
                <Border
                    Height="1"
                    Margin="8,4"
                    Background="#14000000" />
                <!-- 返回主面板 -->
                <Button
                    x:Name="BackButton"
                    Style="{StaticResource ToolButtonStyle}"
                    ToolTipService.ToolTip="返回主面板"
                    Click="OnBackClick">
                    <Viewbox Width="20" Height="20">
                        <Path
                            Width="24"
                            Height="24"
                            Data="M10.3 19.72a1 1 0 0 0 1.4-1.42L6.42 13h13.35a1 1 0 1 0 0-2H6.42l5.28-5.3a1 1 0 0 0-1.4-1.42l-7 7.01a1 1 0 0 0 0 1.42l7 7.01Z"
                            Fill="#FF2B2B2B"
                            Stretch="None" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </Border>

        <!-- 橡皮贴图：跟随指针移动，压在最上层，不参与命中测试 -->
        <Canvas IsHitTestVisible="False">
            <Image
                x:Name="EraserImage"
                Width="40"
                Height="40"
                Source="Assets/Eraser.png"
                Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
