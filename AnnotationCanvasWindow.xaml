<Window
    x:Class="ClassDock.AnnotationCanvasWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      全屏批注层：底层是进入批注时抓取的屏幕快照，上层是透明画布，
      右侧竖排工具栏直接叠在同一窗口里（避免多窗口争夺置顶层级）。
      WinUI 3 没有 InkCanvas，用 Canvas + Pointer 事件自绘笔迹。
    -->
    <Grid
        x:Name="Root"
        Background="Black"
        PointerPressed="OnPointerPressed"
        PointerMoved="OnPointerMoved"
        PointerReleased="OnPointerReleased"
        PointerCaptureLost="OnPointerCaptureLost">
        <Grid.Resources>
            <!-- 状态画刷 -->
            <SolidColorBrush x:Key="ToolHoverBrush" Color="#0C000000" />
            <SolidColorBrush x:Key="ToolPressedBrush" Color="#16000000" />
            <SolidColorBrush x:Key="ToolCheckedBrush" Color="#160078D4" />
            <SolidColorBrush x:Key="ToolCheckedHoverBrush" Color="#240078D4" />
            <SolidColorBrush x:Key="ToolCheckedPressedBrush" Color="#320078D4" />

            <!-- ToggleButton / Button 各一份模板（XamlCompiler 不支持抽象 ButtonBase 作为 TargetType） -->
            <ControlTemplate x:Key="ToolToggleTemplate" TargetType="ToggleButton">
                <Grid
                    x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolHoverBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolPressedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Checked">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolCheckedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="CheckedPointerOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolCheckedHoverBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="CheckedPressed">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolCheckedPressedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Disabled" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="ToolButtonTemplate" TargetType="Button">
                <Grid
                    x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolHoverBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolPressedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
            </ControlTemplate>

            <Style x:Key="ToolToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FF2B2B2B" />
                <Setter Property="Template" Value="{StaticResource ToolToggleTemplate}" />
            </Style>

            <Style x:Key="ToolButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FF2B2B2B" />
                <Setter Property="Template" Value="{StaticResource ToolButtonTemplate}" />
            </Style>
        </Grid.Resources>

        <Image x:Name="Snapshot" Stretch="Fill" IsHitTestVisible="False" />
        <Canvas x:Name="InkLayer" />

        <!-- 白色圆角竖条卡片：靠右侧垂直居中 -->
        <Border
            x:Name="Card"
            Width="56"
            Margin="0,0,12,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="#FFFFFFFF"
            BorderBrush="#14000000"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6"
            PointerPressed="OnCardPressed">
            <StackPanel Spacing="2">
                <!-- 画笔 -->
                <ToggleButton
                    x:Name="PenButton"
                    Style="{StaticResource ToolToggleStyle}"
                    IsChecked="True"
                    ToolTipService.ToolTip="画笔"
                    Click="OnToolClick">
                    <PathIcon Width="20" Height="20" Data="M20.95 3.05a3.58 3.58 0 0 1 0 5.06l-1.83 1.83-5.06-5.06 1.83-1.83a3.58 3.58 0 0 1 5.06 0Zm-6.77 1.71L4.1 14.84c-.4.4-.68.92-.8 1.48l-1.19 5.58a.75.75 0 0 0 .87.87l5.58-1.19c.56-.12 1.08-.4 1.48-.8L20.12 10.7l-5.94-5.94Z" />
                </ToggleButton>
                <!-- 几何图形 -->
                <ToggleButton
                    x:Name="ShapesButton"
                    Style="{StaticResource ToolToggleStyle}"
                    ToolTipService.ToolTip="几何图形"
                    Click="OnToolClick">
                    <PathIcon Width="20" Height="20" Data="M9.5 4a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11ZM14.5 14h5c.97 0 1.75.78 1.75 1.75v5c0 .97-.78 1.75-1.75 1.75h-5c-.97 0-1.75-.78-1.75-1.75v-5c0-.97.78-1.75 1.75-1.75Z" />
                </ToggleButton>
                <!-- 橡皮 -->
                <ToggleButton
                    x:Name="EraserButton"
                    Style="{StaticResource ToolToggleStyle}"
                    ToolTipService.ToolTip="橡皮"
                    Click="OnToolClick">
                    <PathIcon Width="20" Height="20" Data="M15.84 2.66a2.25 2.25 0 0 1 3.17.01l2.3 2.33a2.26 2.26 0 0 1 .01 3.21l-9.1 9.27a.75.75 0 0 1-.53.21H7.06l-2.7-2.75a2.25 2.25 0 0 1 .01-3.19L15.84 2.66Zm2.23 1.13a.75.75 0 0 0-1.06-.01L7.61 13.36l3.45 3.51 9.4-9.57a.76.76 0 0 0-.01-1.09l-2.38-2.42Z" />
                </ToggleButton>
                <!-- 尺规与工具 -->
                <ToggleButton
                    x:Name="RulerButton"
                    Style="{StaticResource ToolToggleStyle}"
                    ToolTipService.ToolTip="尺规与工具"
                    Click="OnToolClick">
                    <PathIcon Width="20" Height="20" Data="M17.75 3A2.25 2.25 0 0 1 20 5.25v13.5A2.25 2.25 0 0 1 17.75 21H6.25A2.25 2.25 0 0 1 4 18.75V5.25A2.25 2.25 0 0 1 6.25 3h11.5Zm0 1.5H6.25a.75.75 0 0 0-.75.75v13.5c0 .414.336.75.75.75h11.5a.75.75 0 0 0 .75-.75V5.25a.75.75 0 0 0-.75-.75ZM8.75 8a.75.75 0 0 0 0 1.5h2.5a.75.75 0 0 0 0-1.5h-2.5Zm0 3.25a.75.75 0 0 0 0 1.5h4.5a.75.75 0 0 0 0-1.5h-4.5Zm0 3.25a.75.75 0 0 0 0 1.5h2.5a.75.75 0 0 0 0-1.5h-2.5Z" />
                </ToggleButton>
                <!-- 分隔 -->
                <Border
                    Height="1"
                    Margin="8,4"
                    Background="#14000000" />
                <!-- 返回主面板 -->
                <Button
                    x:Name="BackButton"
                    Style="{StaticResource ToolButtonStyle}"
                    ToolTipService.ToolTip="返回主面板"
                    Click="OnBackClick">
                    <PathIcon Width="20" Height="20" Data="M10.3 19.72a1 1 0 0 0 1.4-1.42L6.42 13h13.35a1 1 0 1 0 0-2H6.42l5.28-5.3a1 1 0 0 0-1.4-1.42l-7 7.01a1 1 0 0 0 0 1.42l7 7.01Z" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
