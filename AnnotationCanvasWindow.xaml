<Window
    x:Class="ClassDock.AnnotationCanvasWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      全屏批注层：底层是进入批注时抓取的屏幕快照，上层是透明画布，
      右侧竖排工具栏直接叠在同一窗口里（避免多窗口争夺置顶层级）。
      WinUI 3 没有 InkCanvas，用 Canvas + Pointer 事件自绘笔迹。
    -->
    <Grid
        x:Name="Root"
        Background="Black"
        PointerPressed="OnPointerPressed"
        PointerMoved="OnPointerMoved"
        PointerReleased="OnPointerReleased"
        PointerCaptureLost="OnPointerCaptureLost">
        <Grid.Resources>
            <!-- 状态画刷 -->
            <SolidColorBrush x:Key="ToolHoverBrush" Color="#0C000000" />
            <SolidColorBrush x:Key="ToolPressedBrush" Color="#16000000" />
            <SolidColorBrush x:Key="ToolCheckedBrush" Color="#160078D4" />
            <SolidColorBrush x:Key="ToolCheckedHoverBrush" Color="#240078D4" />
            <SolidColorBrush x:Key="ToolCheckedPressedBrush" Color="#320078D4" />

            <!-- ToggleButton / Button 各一份模板（XamlCompiler 不支持抽象 ButtonBase 作为 TargetType） -->
            <ControlTemplate x:Key="ToolToggleTemplate" TargetType="ToggleButton">
                <Grid
                    x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolHoverBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolPressedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Checked">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolCheckedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="CheckedPointerOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolCheckedHoverBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="CheckedPressed">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolCheckedPressedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Disabled" />
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
            </ControlTemplate>

            <ControlTemplate x:Key="ToolButtonTemplate" TargetType="Button">
                <Grid
                    x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="8">
                    <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolHoverBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <Storyboard>
                                    <ObjectAnimationUsingKeyFrames
                                        Storyboard.TargetName="Bd"
                                        Storyboard.TargetProperty="Background">
                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource ToolPressedBrush}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
            </ControlTemplate>

            <Style x:Key="ToolToggleStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FF2B2B2B" />
                <Setter Property="Template" Value="{StaticResource ToolToggleTemplate}" />
            </Style>

            <Style x:Key="ToolButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#FF2B2B2B" />
                <Setter Property="Template" Value="{StaticResource ToolButtonTemplate}" />
            </Style>
        </Grid.Resources>

        <Image x:Name="Snapshot" Stretch="Fill" IsHitTestVisible="False" />
        <Canvas x:Name="InkLayer" />

        <!-- 白色圆角竖条卡片：靠右侧垂直居中 -->
        <Border
            x:Name="Card"
            Width="56"
            Margin="0,0,12,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="#FFFFFFFF"
            BorderBrush="#14000000"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6"
            PointerPressed="OnCardPressed">
            <StackPanel Spacing="2">
                <!-- 画笔 -->
                <ToggleButton
                    x:Name="PenButton"
                    Style="{StaticResource ToolToggleStyle}"
                    IsChecked="True"
                    ToolTipService.ToolTip="画笔"
                    Click="OnToolClick">
                    <PathIcon Width="20" Height="20" Data="M4.5 2.75a.75.75 0 0 0-1.5 0v3.5C3 7.22 3.78 8 4.75 8h.27l4.03 8.97c.2.45.59.79 1.04.94a6 6 0 0 0 .27 3.01c.3.6.83 1.08 1.64 1.08s1.35-.48 1.64-1.08a5.79 5.79 0 0 0 .27-3.01c.45-.15.83-.49 1.04-.94L18.98 8h.27C20.22 8 21 7.22 21 6.25v-3.5a.75.75 0 0 0-1.5 0v3.5c0 .14-.11.25-.25.25H4.75a.25.25 0 0 1-.25-.25zM6.66 8h10.68l-3.76 8.35a.3.3 0 0 1-.23.15h-2.7a.3.3 0 0 1-.23-.15zm4.95 10h.78q.1.4.11 1 0 .86-.21 1.26c-.1.22-.2.24-.29.24-.1 0-.18-.02-.29-.24A3 3 0 0 1 11.5 19q0-.6.11-1" />
                </ToggleButton>
                <!-- 几何图形 -->
                <ToggleButton
                    x:Name="ShapesButton"
                    Style="{StaticResource ToolToggleStyle}"
                    ToolTipService.ToolTip="几何图形"
                    Click="OnToolClick">
                    <PathIcon Width="20" Height="20" Data="M8.75 3.5A5.25 5.25 0 0 0 8 13.95v1.5A6.75 6.75 0 1 1 15.46 8h-1.51a5.25 5.25 0 0 0-5.2-4.5m3.5 5.5A3.25 3.25 0 0 0 9 12.25v6.5c0 1.8 1.46 3.25 3.25 3.25h6.5c1.8 0 3.25-1.46 3.25-3.25v-6.5C22 10.45 20.54 9 18.75 9zm-1.75 3.25c0-.97.78-1.75 1.75-1.75h6.5c.97 0 1.75.78 1.75 1.75v6.5c0 .97-.78 1.75-1.75 1.75h-6.5c-.97 0-1.75-.78-1.75-1.75z" />
                </ToggleButton>
                <!-- 橡皮 -->
                <ToggleButton
                    x:Name="EraserButton"
                    Style="{StaticResource ToolToggleStyle}"
                    ToolTipService.ToolTip="橡皮"
                    Click="OnToolClick">
                    <PathIcon Width="18" Height="18" Data="M13.32 2.44a1.5 1.5 0 0 0-2.12 0L2.44 11.2a1.5 1.5 0 0 0 0 2.12l4.24 4.24c.31.32.73.46 1.14.44h6.27a1.5 1.5 0 1 0 0-1H9.36l8.2-8.2a1.5 1.5 0 0 0 0-2.12zm-8.49 7.78 4.95 4.95-1.69 1.69a.5.5 0 0 1-.7 0L3.14 12.6a.5.5 0 0 1 0-.7z" />
                </ToggleButton>
                <!-- 尺规与工具 -->
                <ToggleButton
                    x:Name="RulerButton"
                    Style="{StaticResource ToolToggleStyle}"
                    ToolTipService.ToolTip="尺规与工具"
                    Click="OnToolClick">
                    <PathIcon Width="18" Height="18" Data="M10.5 1c.83 0 1.5.67 1.5 1.5v11c0 .83-.67 1.5-1.5 1.5h-5A1.5 1.5 0 0 1 4 13.5v-11C4 1.67 4.67 1 5.5 1zm-5 1a.5.5 0 0 0-.5.5V4h2.5a.5.5 0 0 1 0 1H5v1.5h3.5a.5.5 0 0 1 0 1H5V9h2.5a.5.5 0 0 1 0 1H5v1.5h3.5a.5.5 0 0 1 0 1H5v1c0 .28.22.5.5.5h5a.5.5 0 0 0 .5-.5v-11a.5.5 0 0 0-.5-.5z" />
                </ToggleButton>
                <!-- 分隔 -->
                <Border
                    Height="1"
                    Margin="8,4"
                    Background="#14000000" />
                <!-- 返回主面板 -->
                <Button
                    x:Name="BackButton"
                    Style="{StaticResource ToolButtonStyle}"
                    ToolTipService.ToolTip="返回主面板"
                    Click="OnBackClick">
                    <PathIcon Width="20" Height="20" Data="M5.9 3.65c.2.2.2.5 0 .7L4.76 5.5H8.5a.5.5 0 0 1 0 1H4.76L5.9 7.65a.5.5 0 1 1-.7.7l-2-2a.5.5 0 0 1 0-.7l2-2c.2-.2.5-.2.7 0M1 6a5 5 0 1 1 10 0A5 5 0 0 1 1 6m5-4a4 4 0 1 0 0 8 4 4 0 0 0 0-8" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
