<Window
    x:Class="ClassDock.BarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ClassDock">
    <!-- 右缘侧边栏：8x80 DIP 胶囊。
         窗口由 DWM 小圆角平滑裁剪，Grip 同步使用半宽圆角；
         不使用 SetWindowRgn，避免二值 region 切断抗锯齿边缘。 -->
    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="Grip"
                CornerRadius="4"
                Background="White"
                Opacity="0.85" />
    </Grid>
</Window>
