                                </Button>

                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource HomeFeatureCardStyle}"
                                    Tag="storage"
                                    Click="OnHomeFeatureCardClick">
                                    <Grid RowDefinitions="104,Auto">
                                        <Border Background="{ThemeResource HomeCardCoolBackgroundBrush}" CornerRadius="7,7,0,0">
                                            <FontIcon
                                                FontSize="34"
                                                Foreground="{ThemeResource HomeCardCoolIconBrush}"
                                                Glyph="&#xE74E;" />
                                        </Border>
                                        <Grid
                                            Grid.Row="1"
                                            Padding="14,10,12,12"
                                            ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Text="配置与存储" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                    Text="占用统计、备份与重置"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <FontIcon
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource AppTertiaryTextBrush}"
                                                Glyph="&#xE76C;" />
                                        </Grid>
                                    </Grid>
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    Style="{StaticResource HomeFeatureCardStyle}"
                                    Tag="annotation"
                                    Click="OnHomeFeatureCardClick">
                                    <Grid RowDefinitions="104,Auto">
                                        <Border Background="{ThemeResource HomeCardNeutralBackgroundBrush}" CornerRadius="7,7,0,0">
                                            <FontIcon
                                                FontSize="34"
                                                Foreground="{ThemeResource HomeCardNeutralIconBrush}"
                                                Glyph="&#xE70F;" />
                                        </Border>
                                        <Grid
                                            Grid.Row="1"
                                            Padding="14,10,12,12"
                                            ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Text="批注设置" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource AppSecondaryTextBrush}"
                                                    Text="交互模式、采样率与笔迹"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <FontIcon
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource AppTertiaryTextBrush}"
                                                Glyph="&#xE76C;" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </Grid>

                            <CheckBox
                                x:Name="HomeDefaultPageCheck"
                                Margin="0,8,0,0"
                                Checked="OnHomeDefaultPageChanged"
                                Content="打开设置时默认打开此页"
                                Unchecked="OnHomeDefaultPageChanged" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 第三方库滑出面板 -->
                <Border
                    x:Name="LibrariesBackdrop"
                    Background="#33000000"
                    Visibility="Collapsed"
                    Tapped="OnLibrariesBackdropTapped" />

                <Border
                    x:Name="LibrariesPanel"
                    Width="320"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource AppPageBackgroundBrush}"
                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="LibrariesPanelTransform" X="320" />
                    </Border.RenderTransform>
                    <Grid RowDefinitions="Auto,*">
                        <!-- 标题栏 -->
                        <Grid
                            Grid.Row="0"
                            Height="48"
                            ColumnDefinitions="*,Auto"
                            Padding="16,0,12,0">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="第三方库" />
                            <Button
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                Click="OnLibrariesCloseClick">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{ThemeResource AppTextBrush}"
                                    Glyph="&#xE8BB;" />
                            </Button>
                        </Grid>
                        <!-- 库列表 -->
                        <ScrollViewer
                            Grid.Row="1"
                            Padding="4,0,0,0"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="2" Padding="12,0,12,16">
                                <Grid ColumnDefinitions="Auto,*" Height="40">
                                    <FontIcon
                                        Grid.Column="0"
                                        Width="20"
                                        Margin="0,0,12,0"
                                        FontSize="14"
                                        Foreground="{ThemeResource AppTextBrush}"
                                        Glyph="&#xE8B7;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="Microsoft.WindowsAppSDK" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Height="40">
                                    <FontIcon
                                        Grid.Column="0"
                                        Width="20"
                                        Margin="0,0,12,0"
                                        FontSize="14"
                                        Foreground="{ThemeResource AppTextBrush}"
                                        Glyph="&#xE8B7;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="Microsoft.Windows.SDK.BuildTools" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Height="40">
                                    <FontIcon
                                        Grid.Column="0"
                                        Width="20"
                                        Margin="0,0,12,0"
                                        FontSize="14"
                                        Foreground="{ThemeResource AppTextBrush}"
                                        Glyph="&#xE8B7;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="Fluent UI System Icons" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>
