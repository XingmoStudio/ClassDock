                                Style="{StaticResource NavItemStyle}"
                                Tag="debug"
                                Click="OnNavClick">
                                <Grid ColumnDefinitions="3,Auto,*">
                                    <Border
                                        x:Name="DebugAccent"
                                        Width="3"
                                        Margin="0,5,0,5"
                                        Background="Transparent"
                                        CornerRadius="1.5" />
                                    <Viewbox Grid.Column="1" Width="20" Height="20" Margin="7,0,0,0">
                                        <Path
                                            Width="20"
                                            Height="20"
                                            Data="M17 15.555V10.5a.6.6 0 0 0-.07-.273a.37.37 0 0 0-.172-.149a1 1 0 0 0-.235-.062a2 2 0 0 0-.257-.016H16V5.117q.047-.101.133-.242t.164-.312q.078-.173.14-.32A.7.7 0 0 0 16.5 4a2 2 0 0 0-.07-.32a7 7 0 0 0-.157-.493l-.18-.5a6 6 0 0 1-.116-.343a.57.57 0 0 0-.188-.25A.47.47 0 0 0 15.5 2h-2a.55.55 0 0 0-.297.102a.46.46 0 0 0-.18.242q-.039.117-.125.351a14 14 0 0 0-.171.5q-.087.265-.157.493q-.07.226-.07.312q0 .11.063.25q.061.14.148.313a17 17 0 0 0 .289.554V10h-.266q-.14 0-.265.016a.7.7 0 0 0-.235.07a.44.44 0 0 0-.171.148a.5.5 0 0 0-.063.266v5.055q0 .507.203.953t.547.781A2.5 2.5 0 0 0 14.5 18q.5 0 .953-.195a2.7 2.7 0 0 0 .797-.524q.345-.327.547-.773a2.3 2.3 0 0 0 .203-.953M15 10h-1V5a.5.5 0 0 0-.055-.227l-.406-.812l.32-.961h1.282l.32.96l-.406.813A.5.5 0 0 0 15 5zm-2 2v-1h3v1zm3 1v2.5q.008.297-.117.578a1.6 1.6 0 0 1-.328.485A1.5 1.5 0 0 1 14.5 17a1.3 1.3 0 0 1-.578-.117A1.5 1.5 0 0 1 13 15.5V13zM6 2.542a.5.5 0 0 0-.688-.464A4.501 4.501 0 0 0 5 10.283V16a2 2 0 0 0 4 0v-5.716a4.5 4.5 0 0 0-.312-8.205a.5.5 0 0 0-.688.464V6a1 1 0 1 1-2 0zm-2.5 3.71c0-1.19.593-2.24 1.5-2.874v2.62a2 2 0 1 0 4 0v-2.62a3.501 3.501 0 0 1-.688 6.119A.5.5 0 0 0 8 9.96V16a1 1 0 1 1-2 0V9.96a.5.5 0 0 0-.312-.463A3.5 3.5 0 0 1 3.5 6.25"
                                            Fill="#FF2B2B2B"
                                            Stretch="None" />
                                    </Viewbox>
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="测试与调试" />
                                </Grid>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部：关闭软件 -->
                    <Button
                        Grid.Row="1"
                        Height="40"
                        Margin="0,8,0,0"
                        Padding="8,0,8,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        Foreground="#FFC42B1C"
                        FontSize="14"
                        Click="OnNavExitClick">
                        <Grid ColumnDefinitions="Auto,*">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#FFC42B1C"
                                Glyph="&#xE711;" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="关闭软件" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1">

                <!-- 关于 ClassDock -->
                <ScrollViewer x:Name="AboutPage" Visibility="Visible">
                    <StackPanel Padding="28,12,28,28" Spacing="16">

                        <Border
                            Height="180"
                            Background="#FFEFEFF1"
                            CornerRadius="8">
                            <Image Source="Assets/Title.png" Stretch="UniformToFill" />
                        </Border>

                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="关于 ClassDock" />

                        <!-- 版本信息卡片 -->
                        <Border
                            Background="#FFFFFFFF"
                            BorderBrush="#14000000"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14,16,14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                    FontSize="20"
                                    Glyph="&#xE7F8;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="ClassDock" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#66000000"
                                    Text="0.0.1.0 (Codename In The Making)" />
                            </Grid>
                        </Border>

                        <!-- 版权卡片 -->
                        <Border
                            Background="#FFFFFFFF"
                            BorderBrush="#14000000"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14,16,14">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="13" Text="Copyright (c) 2026 Xingmo" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#66000000"
                                    Text="本项目基于 GNU General Public License v3.0 获得许可。" />
                            </StackPanel>
                        </Border>

                        <!-- 常用链接卡片 -->
                        <Border
                            Background="#FFFFFFFF"
                            BorderBrush="#14000000"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14,16,14">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="常用链接" />
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <HyperlinkButton
                                        Content="项目主页"
                                        FontSize="13"
                                        NavigateUri="https://github.com/XingmoStudio/ClassDock" />
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 调试 -->
                <ScrollViewer x:Name="DebugPage" Visibility="Collapsed">
                    <StackPanel Padding="28,12,28,28" Spacing="16">

                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="测试与调试" />

                        <TextBlock
                            FontSize="13"
                            Foreground="#66000000"
                            TextWrapping="Wrap"
                            Text="选择应用在遇到未处理异常时的处理方式。" />

                        <Border
                            Background="#FFFFFFFF"
                            BorderBrush="#14000000"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14,16,16">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="崩溃时的处理方式" />

                                <RadioButton
                                    x:Name="CrashSilentExit"
                                    Margin="0,6,0,0"
                                    Content="崩溃时静默退出"
                                    GroupName="CrashBehavior"
                                    Checked="OnCrashBehaviorChanged" />
                                <RadioButton
                                    x:Name="CrashShowError"
                                    Content="崩溃时显示错误信息"
                                    GroupName="CrashBehavior"
                                    Checked="OnCrashBehaviorChanged" />
                                <RadioButton
                                    x:Name="CrashRestart"
                                    Content="崩溃时静默重启"
                                    GroupName="CrashBehavior"
                                    Checked="OnCrashBehaviorChanged" />

                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="12"
                                    Foreground="#66000000"
                                    TextWrapping="Wrap"
                                    Text="静默重启会尝试重新启动 ClassDock；若启动阶段反复崩溃，会自动改为静默退出以避免重启循环。" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 未开放页面：保持空白 -->
                <Grid x:Name="BlankPage" Visibility="Collapsed" />

            </Grid>
        </Grid>
    </Grid>
</Window>
