                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部：关闭软件 -->
                    <Button
                        x:Name="ExitButton"
                        Grid.Row="1"
                        Height="40"
                        Margin="0,8,0,0"
                        Padding="8,0,8,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        Foreground="#FFC42B1C"
                        FontSize="14"
                        Click="OnNavExitClick">
                        <Grid ColumnDefinitions="Auto,*">
                            <FontIcon
                                x:Name="ExitIcon"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#FFC42B1C"
                                Glyph="&#xE711;" />
                            <TextBlock
                                x:Name="ExitText"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="关闭软件" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1">

                <!-- 关于 ClassDock -->
                <ScrollViewer x:Name="AboutPage" Visibility="Visible">
                    <StackPanel Padding="28,12,28,28" Spacing="16">

                        <Border
                            Background="#FFEFEFF1"
                            CornerRadius="8">
                            <Image
                                Source="Assets/Title.png"
                                HorizontalAlignment="Stretch"
                                Stretch="Uniform" />
                        </Border>

                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="关于 ClassDock" />

                        <!-- 版本信息卡片 -->
                        <Border
                            Background="#FFFFFFFF"
                            BorderBrush="#14000000"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14,16,14">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <FontIcon
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                    FontSize="20"
                                    Glyph="&#xE7F8;" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="ClassDock" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="#66000000"
                                    Text="0.0.5.0 (Codename PaintingTheWorld)" />
                            </Grid>
                        </Border>

                        <!-- 版权卡片 -->
                        <Border
                            Background="#FFFFFFFF"
                            BorderBrush="#14000000"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14,16,14">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="13" Text="Copyright (c) 2026 XingmoStudio" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#66000000"
                                    Text="本项目基于 GNU General Public License v3.0 获得许可。" />
                            </StackPanel>
                        </Border>

                        <!-- 常用链接卡片 -->
                        <Border
                            Background="#FFFFFFFF"
                            BorderBrush="#14000000"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14,16,14">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="常用链接" />
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="16">
                                    <HyperlinkButton
                                        Content="项目主页"
                                        FontSize="13"
                                        Foreground="#FF0078D4"
                                        NavigateUri="https://github.com/XingmoStudio/ClassDock" />
                                    <HyperlinkButton
                                        Content="GitHub"
                                        FontSize="13"
                                        Foreground="#FF0078D4"
                                        NavigateUri="https://github.com/XingmoStudio" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 鸣谢 -->
                        <Border
                            Background="#FFFFFFFF"
                            BorderBrush="#14000000"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14,16,14">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="鸣谢" />
                                <TextBlock FontSize="13" Text="界面主题和部分控件使用了 Windows App SDK (WinUI 3) 框架。" TextWrapping="Wrap" />
                                <TextBlock FontSize="13" TextWrapping="Wrap">
                                    <Run Text="项目灵感源自 " />
                                    <Hyperlink
                                        Foreground="#FF0078D4"
                                        NavigateUri="https://github.com/Alan-CRL/Inkeys">Alan-CRL/Inkeys</Hyperlink>
                                    <Run Text=" 与 " />
                                    <Hyperlink
                                        Foreground="#FF0078D4"
                                        NavigateUri="https://github.com/ClassIsland/ClassIsland">Classisland/Classisland</Hyperlink>
                                    <Run Text="。" />
                                </TextBlock>
                                <TextBlock FontSize="13" Text="感谢 TREA AI 辅助创作（非广）。" />
                                <Button
                                    Margin="0,4,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnLibrariesClick">
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="#FF0078D4"
                                        Text="第三方库" />
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 调试 -->
                <ScrollViewer x:Name="DebugPage" Visibility="Collapsed">
                    <StackPanel Padding="28,12,28,28" Spacing="16">

                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="测试与调试" />

                        <TextBlock
                            FontSize="13"
                            Foreground="#66000000"
                            TextWrapping="Wrap"
                            Text="选择应用在遇到未处理异常时的处理方式。" />

                        <Border
                            Background="#FFFFFFFF"
                            BorderBrush="#14000000"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14,16,16">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="崩溃时的处理方式" />

                                <RadioButton
                                    x:Name="CrashSilentExit"
                                    Margin="0,6,0,0"
                                    Content="静默退出"
                                    GroupName="CrashBehavior"
                                    Checked="OnCrashBehaviorChanged" />
                                <RadioButton
                                    x:Name="CrashShowError"
                                    Content="显示错误信息"
                                    GroupName="CrashBehavior"
                                    Checked="OnCrashBehaviorChanged" />
                                <RadioButton
                                    x:Name="CrashRestart"
                                    Content="静默重启"
                                    GroupName="CrashBehavior"
                                    Checked="OnCrashBehaviorChanged" />

                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="12"
                                    Foreground="#66000000"
                                    TextWrapping="Wrap"
                                    Text="静默重启会尝试重新启动 ClassDock；若启动阶段反复崩溃，会自动改为静默退出以避免重启循环。" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 未开放页面：保持空白 -->
                <Grid x:Name="BlankPage" Visibility="Collapsed" />

                <!-- 第三方库滑出面板 -->
                <Border
                    x:Name="LibrariesBackdrop"
                    Background="#33000000"
                    Visibility="Collapsed"
                    Tapped="OnLibrariesBackdropTapped" />

                <Border
                    x:Name="LibrariesPanel"
                    Width="320"
                    HorizontalAlignment="Right"
                    Background="#FFF9F9F9"
                    BorderBrush="#14000000"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="LibrariesPanelTransform" X="320" />
                    </Border.RenderTransform>
                    <Grid RowDefinitions="Auto,*">
                        <!-- 标题栏 -->
                        <Grid
                            Grid.Row="0"
                            Height="48"
                            ColumnDefinitions="*,Auto"
                            Padding="16,0,12,0">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="第三方库" />
                            <Button
                                Grid.Column="1"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                Click="OnLibrariesCloseClick">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="#FF2B2B2B"
                                    Glyph="&#xE8BB;" />
                            </Button>
                        </Grid>
                        <!-- 库列表 -->
                        <ScrollViewer
                            Grid.Row="1"
                            Padding="4,0,0,0"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="2" Padding="12,0,12,16">
                                <Grid ColumnDefinitions="Auto,*" Height="40">
                                    <FontIcon
                                        Grid.Column="0"
                                        Width="20"
                                        Margin="0,0,12,0"
                                        FontSize="14"
                                        Foreground="#FF2B2B2B"
                                        Glyph="&#xE8B7;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="Microsoft.WindowsAppSDK" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Height="40">
                                    <FontIcon
                                        Grid.Column="0"
                                        Width="20"
                                        Margin="0,0,12,0"
                                        FontSize="14"
                                        Foreground="#FF2B2B2B"
                                        Glyph="&#xE8B7;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="Microsoft.Windows.SDK.BuildTools" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>
