<Window
    x:Class="ClassDock.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClassDock"
    Title="ClassDock 设置">

    <!-- 标题栏与三个窗口按键合并：第 0 行为拖拽区（右端只放版本号） -->
    <Grid x:Name="Root" Background="{ThemeResource AppPageBackgroundBrush}" RowDefinitions="48,*">

        <Grid.Resources>
            <!-- 侧边栏一级条目：20 图标 + 文字，选中态由代码着色 -->
            <Style x:Key="NavItemStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="8,0,8,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- 分组内的二级条目：缩进、字号略小 -->
            <Style x:Key="NavSubItemStyle" TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- 一级分组右侧的展开/收起箭头：独立按钮，避免与整行跳转冲突 -->
            <Style x:Key="NavChevronStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <!-- 警告操作按钮（重置配置等不可逆操作） -->
            <Style x:Key="WarningButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#FFC42B1C" />
                <Setter Property="BorderBrush" Value="#FFC42B1C" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="14,5,14,5" />
            </Style>

            <!-- 主页功能卡：整卡可点，沿用卡片白底/描边/8 圆角规范 -->
            <Style x:Key="HomeFeatureCardStyle" TargetType="Button">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{ThemeResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>

        <!-- 自绘标题栏拖拽区；右侧留出 3 个系统按键（约 46px×3）的位置 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,156,0"
                FontSize="12"
                Foreground="{ThemeResource AppTertiaryTextBrush}"
                Text="{x:Bind local:AppInfo.VersionWithCodename}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border
                x:Name="SidebarPanel"
                Grid.Column="0"
                Width="208"
                Background="{ThemeResource AppSidebarBackgroundBrush}"
                BorderBrush="{ThemeResource AppCardBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid Padding="8,8,8,10" RowDefinitions="*,Auto">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2">

                            <Grid x:Name="HeaderBar" Margin="10,2,0,12" ColumnDefinitions="Auto,*">
                                <Button
                                    x:Name="CollapseToggle"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    Click="OnCollapseToggleClick">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource AppTextBrush}"
                                        Glyph="&#xE700;" />
                                </Button>
                                <TextBlock
                                    x:Name="SettingsTitle"
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="设置" />
                            </Grid>

                            <!-- 关于 ClassDock（唯一有内容的页面之一） -->
                            <Button
                                x:Name="NavAbout"
                                Style="{StaticResource NavItemStyle}"
                                Tag="about"
                                Click="OnNavClick">
                                <Grid ColumnDefinitions="3,Auto,*">
                                    <Border
                                        x:Name="AboutAccent"
                                        Width="3"
                                        Margin="0,5,0,5"
                                        Background="Transparent"
                                        CornerRadius="1.5" />
                                    <Canvas x:Name="AboutIcon" Grid.Column="1" Width="20" Height="20" Margin="7,0,0,0">
                                        <Path
