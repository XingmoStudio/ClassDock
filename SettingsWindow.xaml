                                            Fill="{ThemeResource AppTextBrush}"
                                            Stretch="None" />
                                    </Canvas>
                                    <TextBlock
                                        x:Name="AboutText"
                                        Grid.Column="2"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="关于 ClassDock" />
                                </Grid>
                            </Button>

