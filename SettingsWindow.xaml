<Window
    x:Class="ClassDock.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ClassDock 设置">

    <!-- 标题栏与三个窗口按键合并：第 0 行为拖拽区（右端只放版本号） -->
    <Grid x:Name="Root" Background="#FFF9F9F9" RowDefinitions="48,*">

        <Grid.Resources>
            <!-- 侧边栏一级条目：20 图标 + 文字，选中态由代码着色 -->
            <Style x:Key="NavItemStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="8,0,8,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Foreground" Value="#FF2B2B2B" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- 分组内的二级条目：缩进、字号略小 -->
            <Style x:Key="NavSubItemStyle" TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
                <Setter Property="Height" Value="36" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </Grid.Resources>

        <!-- 自绘标题栏拖拽区；右侧留出 3 个系统按键（约 46px×3）的位置 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,156,0"
                FontSize="12"
                Foreground="#99000000"
                Text="0.0.5.0 (Codename PaintingTheWorld)" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border
                Grid.Column="0"
                Background="#FFF3F3F3"
                BorderBrush="#14000000"
                BorderThickness="0,0,1,0">
                <Grid Padding="8,8,8,10" RowDefinitions="*,Auto">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2">

                            <Grid x:Name="HeaderBar" Margin="10,2,0,12" ColumnDefinitions="Auto,*">
                                <Button
                                    x:Name="CollapseToggle"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    Click="OnCollapseToggleClick">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="#FF2B2B2B"
                                        Glyph="&#xE700;" />
                                </Button>
                                <TextBlock
                                    x:Name="SettingsTitle"
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="设置" />
                            </Grid>

                            <!-- 关于 ClassDock（唯一有内容的页面之一） -->
                            <Button
                                x:Name="NavAbout"
                                Style="{StaticResource NavItemStyle}"
                                Tag="about"
                                Click="OnNavClick">
                                <Grid ColumnDefinitions="3,Auto,*">
                                    <Border
                                        x:Name="AboutAccent"
                                        Width="3"
                                        Margin="0,5,0,5"
                                        Background="Transparent"
                                        CornerRadius="1.5" />
                                    <Viewbox x:Name="AboutIcon" Grid.Column="1" Width="20" Height="20" Margin="7,0,0,0">
                                        <Path
                                            Width="22"
                                            Height="22"
                                            Data="M10.492 8.91A.5.5 0 0 0 9.5 9v4.502l.008.09a.5.5 0 0 0 .992-.09V9zM10.799 6.75a.75.75 0 1 0-1.5 0a.75.75 0 0 0 1.5 0M18 10a8 8 0 1 0-16 0a8 8 0 0 0 16 0M3 10a7 7 0 1 1 14 0a7 7 0 0 1-14 0"
                                            Fill="#FF2B2B2B"
                                            Stretch="None" />
                                    </Viewbox>
                                    <TextBlock
                                        x:Name="AboutText"
                                        Grid.Column="2"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="关于 ClassDock" />
                                </Grid>
                            </Button>

                            <!-- 主页 -->
                            <Button
                                x:Name="NavHome"
                                Style="{StaticResource NavItemStyle}"
                                Tag="blank"
                                Click="OnNavClick">
